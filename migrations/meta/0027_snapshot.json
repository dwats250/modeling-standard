        },
        "brief_item_shape_known": {
          "name": "brief_item_shape_known",
          "value": "\"brief_item\".\"shape\" in ('declaration', 'request', 'open_parameter')"
        },
        "brief_item_item_key_known": {
          "name": "brief_item_item_key_known",
          "value": "\"brief_item\".\"item_key\" in ('fee', 'no_means_no', 'coverage_level', 'physical_contact', 'stop_rule')"
        },
        "brief_item_pending_known": {
          "name": "brief_item_pending_known",
          "value": "\"brief_item\".\"pending\" in ('decide_together', 'subject')"
        },
        "brief_item_content_nonblank": {
          "name": "brief_item_content_nonblank",
          "value": "\"brief_item\".\"content\" ~ '[^[:space:]]'"
        },
        "brief_item_value_nonblank": {
          "name": "brief_item_value_nonblank",
          "value": "\"brief_item\".\"value\" ~ '[^[:space:]]'"
        },
        "brief_item_money_is_pair_scoped": {
          "name": "brief_item_money_is_pair_scoped",
          "value": "\"brief_item\".\"layer\" <> 'money' OR \"brief_item\".\"pairwise_agreement_id\" IS NOT NULL"
        },
        "brief_item_money_is_fee": {
          "name": "brief_item_money_is_fee",
          "value": "\"brief_item\".\"layer\" <> 'money' OR \"brief_item\".\"item_key\" IS NOT DISTINCT FROM 'fee'"
        },
        "brief_item_fee_is_money": {
          "name": "brief_item_fee_is_money",
          "value": "\"brief_item\".\"item_key\" IS DISTINCT FROM 'fee' OR \"brief_item\".\"layer\" = 'money'"
        },
        "brief_item_universal_is_project_wide": {
          "name": "brief_item_universal_is_project_wide",
          "value": "\"brief_item\".\"layer\" <> 'universal' OR \"brief_item\".\"pairwise_agreement_id\" IS NULL"
        },
        "brief_item_no_means_no_is_universal": {
          "name": "brief_item_no_means_no_is_universal",
          "value": "\"brief_item\".\"item_key\" IS DISTINCT FROM 'no_means_no' OR \"brief_item\".\"layer\" = 'universal'"
        },
        "brief_item_shape_iff_subject": {
          "name": "brief_item_shape_iff_subject",
          "value": "(\"brief_item\".\"subject_party_id\" IS NULL) = (\"brief_item\".\"shape\" IS NULL)"
        },
        "brief_item_drafter_item_has_wording": {
          "name": "brief_item_drafter_item_has_wording",
          "value": "\"brief_item\".\"item_key\" IS NOT NULL OR \"brief_item\".\"content\" IS NOT NULL"
        },
        "brief_item_decide_together_has_no_value": {
          "name": "brief_item_decide_together_has_no_value",
          "value": "\"brief_item\".\"pending\" IS DISTINCT FROM 'decide_together' OR \"brief_item\".\"value\" IS NULL"
        },
        "brief_item_subject_pending_is_open_parameter": {
          "name": "brief_item_subject_pending_is_open_parameter",
          "value": "\"brief_item\".\"pending\" IS DISTINCT FROM 'subject' OR \"brief_item\".\"shape\" IS NOT DISTINCT FROM 'open_parameter'"
        },
        "brief_item_open_parameter_state": {
          "name": "brief_item_open_parameter_state",
          "value": "\"brief_item\".\"shape\" IS DISTINCT FROM 'open_parameter' OR (\"brief_item\".\"pending\" IS NOT DISTINCT FROM 'subject' AND \"brief_item\".\"value\" IS NULL) OR (\"brief_item\".\"pending\" IS NULL AND \"brief_item\".\"value\" IS NOT NULL)"
        },
        "brief_item_position_positive": {
          "name": "brief_item_position_positive",
          "value": "\"brief_item\".\"position\" >= 1"
        }
      },
      "isRLSEnabled": false
    },
