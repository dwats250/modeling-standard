# Local development only. Copy to .env: `cp .env.example .env`.
# These credentials match db/provision.sql and compose.yaml and are not secrets.

# Application (runtime credential).
DATABASE_URL=postgres://ms_runtime:ms_runtime_local_only@127.0.0.1:5432/modeling_standard
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Migration command only (migration credential). The application never reads this.
MIGRATION_DATABASE_URL=postgres://ms_migrator:ms_migrator_local_only@127.0.0.1:5432/modeling_standard

# Demo regression only (`npm run test:demo`): a Chrome or Chromium executable.
# Uncomment and point it at your browser, e.g. /usr/bin/google-chrome or
# "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome".
# CHROME_PATH=/usr/bin/chromium
